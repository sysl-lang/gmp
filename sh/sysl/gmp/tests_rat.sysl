module sh.sysl.gmp
@tests

// What `Rat` and `Random` claim. Rationals are checked against hand-worked fractions and the
// harmonic number H(10) = 7381/2520; the generators against themselves (a seed is a sequence) and
// their stated bounds.

private q(n: long, d: long = 1) -> Rat = Rat.of(n, d)

@test("of puts a fraction in lowest terms with a positive denominator")
of_canonical()
    val x = q(6, -4)

    assert_eq(x.num, Int.of(-3))
    assert_eq(x.den, Int.of(2))
    assert_eq(x, q(-3, 2))
    assert_eq(q(0, -5).den, Int.of(1))
    assert_eq(q(-9223372036854775808, -9223372036854775808), q(1))
    assert_eq(Rat.of(Int.of(7)), q(7))

@test("Rat.of with a zero denominator stops the program", should_trap: "Rat division by zero")
of_zero_den()
    print(q(1, 0))

@test("from answers None for a zero denominator")
from_cases()
    assert_eq(Rat.from(Int.of(10), Int.of(-4)), Some(q(-5, 2)))
    assert_eq(Rat.from(Int.of(1), Int.of(0)), None)

@test("parse reads n and n/d in any base, and refuses what is wrong")
parse_cases()
    assert_eq(Rat.parse("3/4").unwrap(), q(3, 4))
    assert_eq(Rat.parse("-10/4").unwrap(), q(-5, 2))
    assert_eq(Rat.parse("7").unwrap(), q(7))
    assert_eq(Rat.parse("ff/10", 16).unwrap(), q(255, 16))
    assert_eq(Rat.parse("1/0").err(), Some(ZeroDenominator))
    assert_eq(Rat.parse("1/-2").err(), Some(InvalidDigits))
    assert_eq(Rat.parse("1/").err(), Some(InvalidDigits))
    assert_eq(Rat.parse("a/2").err(), Some(InvalidDigits))
    assert_eq(Rat.parse("").err(), Some(Empty))
    assert_eq(Rat.parse("1/2", 99).err(), Some(InvalidBase))
    assert_eq(Rat.parse("1/2\u{0}").err(), Some(InvalidDigits))
    assert_eq(Rat.parse("1/23456"[0..<3]).unwrap(), q(1, 2))

@test("from_real is exact, and refuses NaN and infinities")
rat_from_real_cases()
    assert_eq(Rat.from_real(0.75), Some(q(3, 4)))
    assert_eq(Rat.from_real(-0.1).unwrap().den, Int.power(2, 55))
    assert_eq(Rat.from_real(0.0 / 0.0), None)
    assert_eq(Rat.from_real(1.0 / 0.0), None)
    assert_eq(q(1, 4).to_real(), 0.25)

@test("the four operations, with Rat and long operands")
arithmetic()
    assert_eq(q(1, 2) + q(1, 3), q(5, 6))
    assert_eq(q(1, 2) - q(1, 3), q(1, 6))
    assert_eq(q(2, 3) * q(9, 4), q(3, 2))
    assert_eq(q(2, 3) / q(4, 9), q(3, 2))
    assert_eq(q(1, 2) + 1, q(3, 2))
    assert_eq(q(1, 2) - 1, q(-1, 2))
    assert_eq(q(1, 2) * -4, q(-2))
    assert_eq(q(1, 2) / 3, q(1, 6))
    assert_eq(-q(1, 2), q(-1, 2))

@test("H(10), the tenth harmonic number, is 7381/2520")
harmonic()
    var h = q(0)

    for k in 1..10 do h += q(1, k)

    assert_eq(h, q(7381, 2520))
    assert_eq(h.to_string(), "7381/2520")

@test("Rat / zero stops the program", should_trap: "Rat division by zero")
div_zero()
    print(q(1) / q(0))

@test("Rat / 0 as a long stops the program", should_trap: "Rat division by zero")
div_zero_long()
    print(q(1) / 0)

@test("inv, abs and the power-of-two scalings")
rat_unary()
    assert_eq(q(-2, 3).inv(), Some(q(-3, 2)))
    assert_eq(q(0).inv(), None)
    assert_eq(q(-2, 3).abs(), q(2, 3))
    assert_eq(q(3, 4).mul_pow2(3), q(6))
    assert_eq(q(3, 4).div_pow2(1), q(3, 8))

@test("floor, ceil and trunc on both signs")
rounding()
    assert_eq(q(7, 2).floor(), Int.of(3))
    assert_eq(q(7, 2).ceil(), Int.of(4))
    assert_eq(q(-7, 2).floor(), Int.of(-4))
    assert_eq(q(-7, 2).ceil(), Int.of(-3))
    assert_eq(q(-7, 2).trunc(), Int.of(-3))
    assert_eq(q(4).floor(), Int.of(4))

@test("ordering, compare, sign and is_integer")
ordering()
    assert(q(1, 3) < q(1, 2), "1/3 < 1/2")
    assert(q(-1, 2) < q(-1, 3), "-1/2 < -1/3")
    assert(q(2, 4) == q(1, 2), "2/4 = 1/2")
    assert_eq(q(5, 2).compare(q(2)), 1)
    assert_eq(q(5, 2).compare(Int.of(3)), -1)
    assert_eq(q(5, 2).compare(10, 4), 0)
    assert_eq(q(5, 2).compare(-10, 4), 1)
    assert_eq(q(-5, 2).sign, -1)
    assert_eq(q(0).sign, 0)
    assert(q(0).is_zero, "zero")
    assert(q(8, 4).is_integer, "8/4")
    assert(!q(8, 3).is_integer, "8/3")

@test("compare with a zero denominator stops the program", should_trap: "Rat division by zero")
compare_zero_den()
    print(q(1).compare(1, 0))

@test("rendering in bases, and through Display with a width")
rendering()
    assert_eq(q(-255, 16).to_string_base(16), "-ff/10")
    assert_eq(q(-255, 16).to_string_base(-16), "-FF/10")
    assert_eq(q(5).to_string(), "5")
    assert_eq(f"[${q(1, 2)}%5s]", "[  1/2]")

@test("Rat base 1 stops the program", should_trap: "is not 2 to 62")
rat_bad_base()
    print(q(1).to_string_base(1))

@test("copies are independent and equal values hash equally")
copy_hash()
    val a = q(3, 4)
    val b = a.copy()

    assert_eq(a, b)
    assert_eq(a.hash(), Rat.parse("6/8").unwrap().hash())
    assert(a.hash() != q(4, 3).hash(), "num and den are not interchangeable")

// -- Random ---------------------------------------------------------------------------------------

@test("one seed is one sequence; another seed is another")
random_seeded()
    val a = Random.new(42)
    val b = Random.new(42)
    val c = Random.new(43)

    val x = a.bits(256)

    assert_eq(x, b.bits(256))
    assert(x != c.bits(256), "a different seed")
    assert(a.bits(256) != x, "the sequence moves on")

@test("copy continues the same sequence, reseed restarts it")
random_copy_reseed()
    val a = Random.mersenne(7)

    a.bits(100)

    val b = a.copy()

    assert_eq(a.below(Int.power(10, 30)), b.below(Int.power(10, 30)))

    a.reseed(7)

    val first = a.bits(64)

    a.reseed(Int.of(7))
    assert_eq(a.bits(64), first)

    val fresh = Random.mersenne(7)

    assert_eq(fresh.bits(64), first)

@test("draws stay within their bounds")
random_bounds()
    val r = Random.new(1)
    val bound = Int.of(1000)

    for _ in 0..<500
        val x = r.below(bound)
        assert(x.sign >= 0 && x < bound, "below")
        assert(r.bits(10) < Int.of(1024), "bits")
        assert(r.word_below(7) < 7, "word_below")
        assert(r.word_bits(3) < 8, "word_bits")
        assert_eq(r.sparse_bits(50).bit_length(), 50)

    assert_eq(r.bits(0), Int.of(0))

@test("the congruential generators")
random_congruential()
    val a = Random.congruential(Int.of(1103515245), 12345, 32, 5)
    val b = Random.congruential(Int.of(1103515245), 12345, 32, 5)

    assert_eq(a.bits(16), b.bits(16))
    assert(Random.congruential_of_size(64, 3).is_some(), "64 bits is in the table")
    assert(Random.congruential_of_size(200).is_none(), "200 bits is not")

@test("below a bound that is not positive stops the program", should_trap: "positive bound")
random_below_zero()
    print(Random.new().below(Int.of(0)))

@test("word_bits past 64 stops the program", should_trap: "at most 64 bits")
random_word_bits_too_many()
    print(Random.new().word_bits(65))

@test("word_below zero stops the program", should_trap: "positive bound")
random_word_below_zero()
    print(Random.new().word_below(0))

@test("version and limb_bits describe the library linked")
library_facts()
    assert(version().starts_with("6."), "GMP 6")
    assert_eq(limb_bits(), 64)
