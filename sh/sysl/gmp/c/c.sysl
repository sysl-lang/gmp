// ## Integers: division
//
// `c` rounds the quotient toward +infinity, `f` toward -infinity, `t` toward zero. Each divides by
// zero with `SIGFPE`, which is why the layer above checks first.

extern "__gmpz_cdiv_q" mpz_cdiv_q(q: *Mpz, n: *Mpz, d: *Mpz)
extern "__gmpz_cdiv_r" mpz_cdiv_r(r: *Mpz, n: *Mpz, d: *Mpz)
