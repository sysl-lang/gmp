// GMP as C declares it: the integer (`mpz`) and rational (`mpq`) layers of `gmp.h`, the random
// state, the allocator hooks, and the three variables the library exports.
//
// **Nothing here is meant to be called by a program.** A GMP value is a struct the caller allocates
// and must `init` before use and `clear` after, an error is a `-1` or a `SIGFPE`, and a string is a
// buffer that has to be sized first. `sh.sysl.gmp` turns that into an `Int`, a `Rat` and a `Random`
// that free themselves, and is what an application imports.
//
// **Every public name in `gmp.h` is a macro.** `mpz_add` is `#define`d to `__gmpz_add`, so each
// `extern` below names the real exported symbol and keeps the documented name. There is no C in this
// package: the handful of function-like macros (`mpz_sgn`, `mpz_odd_p`, `mpz_even_p`, `mpq_sgn`,
// `mpq_numref`, `mpq_denref`) only read fields of the structs below, and the layer above reads them
// the same way. `mpz_cmp_si`/`_ui` and `mpq_cmp_si`/`_ui` are macros over real functions too
// (`__gmpz_cmp_si` and the rest), which are bound here.
//
// **The structs are declared field for field** and `tests.sysl` checks every `sizeof` and `offsetof`
// against the header's own, so a GMP that changes its layout fails a test rather than a read.
//
// **Absent on purpose** (the README says the same):
//
// - the `mpf` floating-point layer (68 functions) — MPFR supersedes it, and GMP's own manual
//   recommends MPFR for new code; it is a separate binding if wanted;
// - the `mpn` limb-array layer (the low-level kernels the others are built on) — it works on raw
//   limb arrays a caller sizes by hand, which is what `mpz` exists to hide;
// - the `gmp_printf` / `gmp_scanf` families — variadic formatting over C's `printf` grammar, where
//   `Display` and `parse` already render and read every value;
// - the variadic `mpz_inits`/`mpz_clears`/`mpq_inits`/`mpq_clears` — conveniences over `init` and
//   `clear`, which are bound;
// - what the manual lists as obsolete or internal: `mpz_random`, `mpz_random2`, `mpz_array_init`,
//   `_mpz_realloc`, `gmp_randinit` (variadic), `mpz_millerrabin`, and the `__gmpz_*` helpers no
//   macro names (`mpz_aorsmul_1`, `mpz_divexact_gcd`, `mpz_lucas_mod`, `mpz_oddfac_1`,
//   `mpz_prodlimbs`, `mpz_stronglucas`, `mpz_inp_str_nowhite`, `mpz_n_pow_ui`, and
//   `__gmpz_legendre`, which the header never names: its `mpz_legendre` is `mpz_jacobi`);
// - `mpz_set_f` and `mpq_set_f`, which take an `mpf`.

module sh.sysl.gmp.c

@link("gmp")

@include("stddef.h")
@include("stdio.h")
@include("gmp.h")

// ## Types C measures

c type
    // `unsigned long` and `long`: the `_ui` and `_si` families take them, and their width is the
    // platform's (64 bits on every LP64 machine, 32 on Windows).
    Ulong = "unsigned long"
    Long = "long"
    Limb = "mp_limb_t"
    Size = "mp_size_t"
    Bitcnt = "mp_bitcnt_t"

// ## Constants

c const
    VERSION_MAJOR: i32 = "__GNU_MP_VERSION"
    VERSION_MINOR: i32 = "__GNU_MP_VERSION_MINOR"
    VERSION_PATCHLEVEL: i32 = "__GNU_MP_VERSION_PATCHLEVEL"
    LIMB_BITS: i32 = "GMP_LIMB_BITS"
    NAIL_BITS: i32 = "GMP_NAIL_BITS"

    // `gmp_errno` bits, set by the random functions and the allocator.
    ERROR_NONE: i32 = "GMP_ERROR_NONE"
    ERROR_UNSUPPORTED_ARGUMENT: i32 = "GMP_ERROR_UNSUPPORTED_ARGUMENT"
    ERROR_DIVISION_BY_ZERO: i32 = "GMP_ERROR_DIVISION_BY_ZERO"
    ERROR_SQRT_OF_NEGATIVE: i32 = "GMP_ERROR_SQRT_OF_NEGATIVE"
    ERROR_INVALID_ARGUMENT: i32 = "GMP_ERROR_INVALID_ARGUMENT"

    RAND_ALG_DEFAULT: i32 = "GMP_RAND_ALG_DEFAULT"

    // The layouts `tests.sysl` holds the structs below to.
    MPZ_SIZE: usize = "sizeof(__mpz_struct)"
    MPZ_OFF_ALLOC: usize = "offsetof(__mpz_struct, _mp_alloc)"
    MPZ_OFF_SIZE: usize = "offsetof(__mpz_struct, _mp_size)"
    MPZ_OFF_D: usize = "offsetof(__mpz_struct, _mp_d)"
    MPQ_SIZE: usize = "sizeof(__mpq_struct)"
    MPQ_OFF_NUM: usize = "offsetof(__mpq_struct, _mp_num)"
    MPQ_OFF_DEN: usize = "offsetof(__mpq_struct, _mp_den)"
    RANDSTATE_SIZE: usize = "sizeof(__gmp_randstate_struct)"
    RANDSTATE_OFF_SEED: usize = "offsetof(__gmp_randstate_struct, _mp_seed)"
    RANDSTATE_OFF_ALG: usize = "offsetof(__gmp_randstate_struct, _mp_alg)"
    RANDSTATE_OFF_ALGDATA: usize = "offsetof(__gmp_randstate_struct, _mp_algdata)"
    LIMB_SIZE: usize = "sizeof(mp_limb_t)"

// ## Structs

// `__mpz_struct`: `alloc` limbs at `d`, of which `|size|` are in use; the sign of `size` is the
// sign of the number, and zero is `size == 0`.
struct Mpz
    alloc: i32
    size: i32
    d: *Limb

// `__mpq_struct`: a numerator and a denominator, kept in lowest terms with `den > 0` by every
// function but `set_num`/`set_den`/`set_str`, after which `mpq_canonicalize` restores it.
struct Mpq
    num: Mpz
    den: Mpz

// `__gmp_randstate_struct`. `algdata` is a one-armed union of a `void *`.
struct RandState
    seed: Mpz
    alg: i32
    algdata: *u8

// `FILE`, for the four functions that read and write a stream.
opaque struct File

// ## Variables

extern "__gmp_version" version: *u8
extern "__gmp_bits_per_limb" bits_per_limb: i32
extern "__gmp_errno" errno: i32

// ## Memory

extern "__gmp_set_memory_functions" set_memory_functions(
    alloc: *extern(usize) -> *u8,
    realloc: *extern(*u8, usize, usize) -> *u8,
    free: *extern(*u8, usize) -> unit)

extern "__gmp_get_memory_functions" get_memory_functions(
    alloc: **extern(usize) -> *u8,
    realloc: **extern(*u8, usize, usize) -> *u8,
    free: **extern(*u8, usize) -> unit)

// ## Integers: initialization and assignment

extern "__gmpz_init" mpz_init(x: *Mpz)
extern "__gmpz_init2" mpz_init2(x: *Mpz, n: Bitcnt)
extern "__gmpz_clear" mpz_clear(x: *Mpz)
extern "__gmpz_realloc2" mpz_realloc2(x: *Mpz, n: Bitcnt)

extern "__gmpz_set" mpz_set(rop: *Mpz, op: *Mpz)
extern "__gmpz_set_ui" mpz_set_ui(rop: *Mpz, op: Ulong)
extern "__gmpz_set_si" mpz_set_si(rop: *Mpz, op: Long)
extern "__gmpz_set_d" mpz_set_d(rop: *Mpz, op: f64)
extern "__gmpz_set_q" mpz_set_q(rop: *Mpz, op: *Mpq)
extern "__gmpz_set_str" mpz_set_str(rop: *Mpz, s: *u8, base: i32) -> i32
extern "__gmpz_swap" mpz_swap(a: *Mpz, b: *Mpz)

extern "__gmpz_init_set" mpz_init_set(rop: *Mpz, op: *Mpz)
extern "__gmpz_init_set_ui" mpz_init_set_ui(rop: *Mpz, op: Ulong)
extern "__gmpz_init_set_si" mpz_init_set_si(rop: *Mpz, op: Long)
extern "__gmpz_init_set_d" mpz_init_set_d(rop: *Mpz, op: f64)
extern "__gmpz_init_set_str" mpz_init_set_str(rop: *Mpz, s: *u8, base: i32) -> i32

