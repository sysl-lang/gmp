extern "__gmpz_sub_ui" mpz_sub_ui(rop: *Mpz, a: *Mpz, b: Ulong)
extern "__gmpz_ui_sub" mpz_ui_sub(rop: *Mpz, a: Ulong, b: *Mpz)
extern "__gmpz_mul" mpz_mul(rop: *Mpz, a: *Mpz, b: *Mpz)
