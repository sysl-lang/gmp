extern "__gmpz_cdiv_ui" mpz_cdiv_ui(n: *Mpz, d: Ulong) -> Ulong
extern "__gmpz_cdiv_q_2exp" mpz_cdiv_q_2exp(q: *Mpz, n: *Mpz, b: Bitcnt)
extern "__gmpz_cdiv_r_2exp" mpz_cdiv_r_2exp(r: *Mpz, n: *Mpz, b: Bitcnt)

extern "__gmpz_fdiv_q" mpz_fdiv_q(q: *Mpz, n: *Mpz, d: *Mpz)
extern "__gmpz_fdiv_r" mpz_fdiv_r(r: *Mpz, n: *Mpz, d: *Mpz)
