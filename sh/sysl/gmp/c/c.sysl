// ## Integers: arithmetic

extern "__gmpz_add" mpz_add(rop: *Mpz, a: *Mpz, b: *Mpz)
extern "__gmpz_add_ui" mpz_add_ui(rop: *Mpz, a: *Mpz, b: Ulong)
